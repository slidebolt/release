# SlideBolt settings. Copy to .env next to compose.yml and fill in what you use:
#   cp .env.example .env
#
# Only the REQUIRED section must be filled in. Every integration below it is
# optional: leave its settings empty and that plugin stays idle or reports
# itself disabled. Generate secrets with: openssl rand -hex 32

# ───────────────────────── REQUIRED ─────────────────────────
# Password for the UI's Postgres database (the ui-db service).
UI_DB_PASSWORD=
# Signs UI login sessions.
UI_SESSION_SECRET=

# ───────────────────────── General ─────────────────────────
# Image version to run, e.g. v1.0.14. "latest" follows new releases on pull.
SLIDEBOLT_VERSION=latest
# Where SlideBolt keeps its data (devices, scripts, logs, zigbee network).
SB_DATA_DIR=./data
TZ=UTC
# Add compose.zigbee.yml to use a Zigbee USB coordinator (see ZIGBEE_ADAPTER).
# Add the "agent" profile to run the OpenCode agent (see the agent section).
# COMPOSE_FILE=compose.yml:compose.zigbee.yml
# COMPOSE_PROFILES=agent

# Generated on first start and kept in $SB_DATA_DIR/identity.env when empty.
# Set them only to keep an identity from another install.
SYSTEM_UUID=
SYSTEM_MAC=

# ───────────────────────── Core services ─────────────────────────
# SlideBolt runs on the host network so plugins can discover LAN devices.
# Change these if a port is already taken on this machine. The UI itself is on
# 49101 and its API on 40001; those are fixed.
SB_API_PORT=29011
SB_MESSENGER_PORT=4222
UI_DB_PORT=5438
SB_LOGGING_TARGET=sqlite
SB_LOGGING_SQLITE_PATH=/app/.data/logs/slidebolt-logs.db
SB_LOGGING_SQLITE_MAX_LOGS=100000
SB_LOGGING_SQLITE_PRUNE_LOGS=150000

# ───────────────────────── Zigbee (plugin-zigbee) ─────────────────────────
# The coordinator on the host, e.g. /dev/serial/by-id/usb-...  Needs compose.zigbee.yml.
ZIGBEE_ADAPTER=
# Shared by zigbee-host and plugin-zigbee. Generated when empty.
ZIGBEE_HOST_TOKEN=

# ───────────────────────── Wi-Fi lights and plugs ─────────────────────────
# Subnets to scan, e.g. 192.168.1.0/24
WIZ_SUBNET=
WIZ_TIMEOUT_MS=500
KASA_SUBNET=
KASA_TIMEOUT_MS=400

# ───────────────────────── ESPHome ─────────────────────────
# Encryption key from the devices' YAML (api: encryption: key)
ESPHOME_API_KEY=
ESPHOME_DASHBOARD_URL=
ESPHOME_DASHBOARD_USER=
ESPHOME_DASHBOARD_PASSWORD=

# ───────────────────────── Cameras ─────────────────────────
AMCREST_HOST=
AMCREST_USERNAME=
AMCREST_PASSWORD=
AMCREST_SCHEME=http
FRIGATE_URL=
FRIGATE_GO2RTC_URL=
FRIGATE_USERNAME=
FRIGATE_PASSWORD=
# Optional MQTT events from Frigate
FRIGATE_MQTT_HOST=
FRIGATE_MQTT_PORT=1883
FRIGATE_MQTT_USER=
FRIGATE_MQTT_PASSWORD=
FRIGATE_MQTT_TOPIC_PREFIX=frigate

# ───────────────────────── Home Assistant ─────────────────────────
# Install the slidebolt-hacs integration in Home Assistant, then:
HA_URL=
HA_LONG_LIVED_ACCESS_TOKEN=
# Port the integration connects to.
HA_PORT=39444

# ───────────────────────── Alexa ─────────────────────────
# From your own deployment of aws-alexa.
ALEXA_WS_URL=
ALEXA_CLIENT_ID=
ALEXA_CLIENT_SECRET=
ALEXA_RELAY_TOKEN=

# ───────────────────────── Android ─────────────────────────
ANDROIDTV_DISCOVERY_TIMEOUT_MS=5000
ANDROIDPHONE_FCM_PROJECT_ID=
ANDROIDPHONE_FCM_CREDENTIALS_JSON=

# ───────────────────────── Phones: Asterisk ─────────────────────────
# Needs your own Asterisk with ARI enabled. Without these, asterisk-host reports
# itself disabled. See stack/asterisk/ for the dialplan SlideBolt expects.
ASTERISK_HOST_BIND=127.0.0.1:47832
ASTERISK_HOST_URL=http://127.0.0.1:47832
ASTERISK_HOST_TOKEN=
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=slidebolt
ASTERISK_ARI_PASS=
# Per extension: what Asterisk cannot tell SlideBolt. listen: never, in_call, on_command.
# e.g. {"300":{"role":"intercom","autoAnswer":true,"listen":"on_command"}}
ASTERISK_HOST_ENDPOINTS=
# Numbers SlideBolt answers itself, e.g. {"4000":{"name":"Agent","call":"agent","text":true}}
ASTERISK_HOST_SERVICES=
ASTERISK_HOST_TRUNKS=
# Outside numbers that may be dialed, comma separated. Empty means none.
ASTERISK_HOST_DIAL_ALLOW=
ASTERISK_HOST_MAX_CALL_SECONDS=900
ASTERISK_HOST_MAX_LISTEN_SECONDS=300

# Media and speech for calls. *_RTP_HOST is the address Asterisk sends audio to.
MEDIA_BIND_ADDR=
MEDIA_PUBLIC_URL=
MEDIA_SIGNING_KEY=
MEDIA_RTP_HOST=
MEDIA_RTP_PORT_MIN=41000
MEDIA_RTP_PORT_MAX=41099
SPEECH_RTP_HOST=
SPEECH_RTP_PORT_MIN=41100
SPEECH_RTP_PORT_MAX=41199
SPEECH_SILENCE_MILLIS=700

# ───────────────────────── Agent (OpenCode) ─────────────────────────
# Runs with COMPOSE_PROFILES=agent. The agent's only tool is SlideBolt's MCP server.
OPENCODE_HOST_URL=http://127.0.0.1:4096
# Password between plugin-opencode and the opencode container.
OPENCODE_HOST_PASSWORD=
# Your OpenCode API key, and the model to use.
OPENCODE_API_KEY=
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
# An sb-api token with read and control scopes (create it in the UI after setup).
OPENCODE_SLIDEBOLT_TOKEN=
# One agent per use: voice (intercom), phone (calls), text (messages).
OPENCODE_AGENTS=voice
OPENCODE_PROMPT_TIMEOUT_SECONDS=120
